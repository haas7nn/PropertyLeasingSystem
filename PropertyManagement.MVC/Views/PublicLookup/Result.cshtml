@model PropertyManagement.MVC.Models.MaintenanceLookupDto
@{
    ViewData["Title"] = "Request Status";

    string sc;
    if      (Model.Status == "Submitted")  sc = "submitted";
    else if (Model.Status == "Assigned")   sc = "assigned";
    else if (Model.Status == "InProgress") sc = "inprogress";
    else if (Model.Status == "Resolved")   sc = "resolved";
    else if (Model.Status == "Closed")     sc = "closed";
    else                                   sc = "pending";

    int pct;
    if      (Model.Status == "Submitted")  pct = 20;
    else if (Model.Status == "Assigned")   pct = 40;
    else if (Model.Status == "InProgress") pct = 60;
    else if (Model.Status == "Resolved")   pct = 80;
    else if (Model.Status == "Closed")     pct = 100;
    else                                   pct = 0;

    string icon;
    if      (Model.Status == "Submitted")  icon = "bi-clock-history";
    else if (Model.Status == "Assigned")   icon = "bi-person-check";
    else if (Model.Status == "InProgress") icon = "bi-gear-fill";
    else if (Model.Status == "Resolved")   icon = "bi-check-circle-fill";
    else if (Model.Status == "Closed")     icon = "bi-check2-all";
    else                                   icon = "bi-question-circle";
}

<div class="container mt-4" style="max-width:780px">
    <div class="mb-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <h1 class="section-title">Maintenance Request</h1>
            <p class="section-sub">Real-time status for ticket @Model.TicketNumber</p>
        </div>
        <a asp-action="Index" class="action-link"><i class="bi bi-arrow-left me-1"></i> Search again</a>
    </div>

    <!-- Ticket header -->
    <div class="card p-0 mb-3" style="overflow:hidden">
        <div style="background:var(--navy);padding:1.5rem 2rem;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem">
            <div>
                <div style="color:rgba(255,255,255,.4);font-size:.72rem;letter-spacing:.06em;text-transform:uppercase;font-weight:700">Ticket number</div>
                <div style="color:#fff;font-size:1.6rem;font-weight:800;letter-spacing:-.04em;font-family:'DM Mono',monospace">@Model.TicketNumber</div>
                <div style="color:rgba(255,255,255,.45);font-size:.8rem;margin-top:2px">Submitted @Model.SubmittedDate.ToString("dd MMM yyyy, h:mm tt")</div>
            </div>
            <span class="badge status-@sc" style="font-size:.85rem;padding:.5em 1em">
                <i class="bi @icon me-1"></i> @Model.Status
            </span>
        </div>

        <!-- Progress bar -->
        <div style="padding:.85rem 2rem;background:#f8fafc;border-bottom:1px solid #e2e8f0">
            <div style="display:flex;justify-content:space-between;margin-bottom:.4rem">
                <span style="font-size:.68rem;font-weight:600;color:var(--muted)">Submitted</span>
                <span style="font-size:.68rem;font-weight:600;color:var(--muted)">Assigned</span>
                <span style="font-size:.68rem;font-weight:600;color:var(--muted)">In Progress</span>
                <span style="font-size:.68rem;font-weight:600;color:var(--muted)">Resolved</span>
                <span style="font-size:.68rem;font-weight:600;color:var(--muted)">Closed</span>
            </div>
            <div style="height:6px;background:#e2e8f0;border-radius:99px;overflow:hidden">
                <div style="height:100%;width:@(pct)%;background:var(--blue);border-radius:99px;transition:width .4s"></div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-8">
            <div class="card p-4">
                <h2 class="section-title mb-3" style="font-size:.9rem">Request Details</h2>
                <table style="width:100%;border-collapse:collapse">
                    <tr>
                        <td style="width:36%;padding:.5rem 0;color:var(--muted);font-size:.82rem;font-weight:600;vertical-align:top">Category</td>
                        <td style="font-size:.88rem;font-weight:600">@Model.Category</td>
                    </tr>
                    <tr>
                        <td style="padding:.5rem 0;color:var(--muted);font-size:.82rem;font-weight:600">Priority</td>
                        <td><span class="badge status-submitted">@Model.Priority</span></td>
                    </tr>
                    <tr>
                        <td style="padding:.5rem 0;color:var(--muted);font-size:.82rem;font-weight:600;vertical-align:top">Description</td>
                        <td style="font-size:.88rem;line-height:1.55">@Model.Description</td>
                    </tr>
                    <tr>
                        <td style="padding:.5rem 0;color:var(--muted);font-size:.82rem;font-weight:600">Building</td>
                        <td style="font-size:.88rem">@Model.Building</td>
                    </tr>
                    <tr>
                        <td style="padding:.5rem 0;color:var(--muted);font-size:.82rem;font-weight:600">Unit</td>
                        <td style="font-size:.88rem;font-weight:700">@Model.Unit</td>
                    </tr>
                </table>

                @if (!string.IsNullOrEmpty(Model.ResolutionNotes))
                {
                    <div class="alert alert-info mt-3 mb-0" style="font-size:.85rem">
                        <strong><i class="bi bi-clipboard-check me-1"></i> Resolution Notes:</strong><br />@Model.ResolutionNotes
                    </div>
                }
            </div>
        </div>

        <div class="col-md-4">
            <div class="card p-3 mb-3">
                <div style="font-size:.72rem;text-transform:uppercase;letter-spacing:.06em;font-weight:700;color:var(--muted);margin-bottom:.6rem">Assigned Technician</div>
                @if (!string.IsNullOrEmpty(Model.AssignedStaff))
                {
                    <div style="display:flex;align-items:center;gap:.6rem">
                        <div style="width:36px;height:36px;background:var(--blue);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:.85rem;font-weight:700">
                            @Model.AssignedStaff[0].ToString().ToUpper()
                        </div>
                        <div>
                            <div style="font-size:.85rem;font-weight:700">@Model.AssignedStaff</div>
                            <div style="font-size:.72rem;color:#16a34a"><i class="bi bi-check-circle-fill me-1"></i>Assigned</div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center" style="padding:.5rem 0;color:var(--muted)">
                        <i class="bi bi-hourglass-split" style="font-size:1.5rem;display:block;margin-bottom:.4rem"></i>
                        <span style="font-size:.82rem">Not yet assigned</span>
                    </div>
                }
            </div>

            @if (Model.ClosedDate.HasValue)
            {
                <div class="card p-3 mb-3" style="background:#f0fdf4;border-color:#bbf7d0">
                    <div style="font-size:.72rem;text-transform:uppercase;letter-spacing:.06em;font-weight:700;color:#16a34a;margin-bottom:.4rem">Completed</div>
                    <div style="font-size:.88rem;font-weight:600">@Model.ClosedDate.Value.ToString("dd MMM yyyy")</div>
                </div>
            }

            <div class="mt-2">
                <button class="btn btn-outline-secondary btn-sm w-100" onclick="window.print()">
                    <i class="bi bi-printer me-1"></i> Print
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<style>@@media print { .site-nav, .site-footer, .action-link, button { display:none !important; } }</style>
}
